{
  "version": "0",
  "meta": {
    "name": "Example X-Schema",
    "description": "Example object editor schema with reusable object types, nested objects, arrays, conditions, defaults and references."
  },
  "root": "Root",

  "types": {
    "Root": {
      "kind": "object",
      "children": [
        {
          "kind": "field",
          "bind": "advanced",
          "dataType": "boolean",
          "tag": "x-datafield",
          "props": { "type": "checkbox", "label": "Advanced mode" },
          "default": false
        },

        {
          "kind": "object",
          "bind": "customer",          
          "required": true,
          "props": { "label": "Customer" },
          "create": { "name": "", "email": "" },
          "children": [
            {
              "kind": "field",
              "bind": "name",
              "dataType": "string",
              "required": true,
              "tag": "x-datafield",
              "props": { "type": "text", "label": "Name" },
              "default": ""
            },
            {
              "kind": "field",
              "bind": "email",
              "dataType": "string",
              "required": true,
              "tag": "x-datafield",
              "props": { "type": "email", "label": "Email" },
              "default": "",
              "conditions": { "visible": { "path": "$root.advanced", "equals": true } }
            }
          ]
        },

        {
          "kind": "array",
          "bind": "addresses",
          "props": { "label": "Addresses" },
          "item": { "type": "Address" },
          "allowAdd": true,
          "allowRemove": true,
          "allowMove": true,
          "minItems": 0,
          "maxItems": 10,
          "default": []
        },

        {
          "kind": "container",
          "tag": "x-panel",
          "props": { "label": "Advanced" },
          "conditions": { "visible": { "path": "$root.advanced", "equals": true } },
          "children": [
            {
              "kind": "field",
              "bind": "notes",
              "dataType": "string",
              "tag": "x-datafield",
              "props": { "type": "textarea", "label": "Notes" },
              "default": ""
            }
          ]
        }
      ]
    },

    "Address": {
      "kind": "object",
      "create": { "street": "", "city": "", "countryId": null },
      "children": [
        {
          "kind": "field",
          "bind": "street",
          "dataType": "string",
          "tag": "x-datafield",
          "props": { "type": "text", "label": "Street" },
          "default": ""
        },
        {
          "kind": "field",
          "bind": "city",
          "dataType": "string",
          "tag": "x-datafield",
          "props": { "type": "text", "label": "City" },
          "default": ""
        },
        {
          "kind": "field",
          "bind": "countryId",
          "dataType": "string",
          "tag": "x-datafield",
          "props": { "type": "select", "label": "Country" },
          "reference": { "source": "$root.countries", "key": "id", "label": "name" }
        }
      ]
    }
  }
}
