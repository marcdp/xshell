                                        "href": "/pages/filesystem/explorer.js"
                                    }
                                ]
                            },
                            {
                                "label": "X Templates",
                                "path": "templates",
                                "href": "/pages/templates/index.js",
                                "children": [
                                    {
                                        "label": "Text Binding",
                                        "path": "templates/basics",
                                        "href": "/pages/templates/basics.js"
                                    },
                                    {
                                        "label": "Attributes and Properties",
                                        "path": "templates/bindings",
                                        "href": "/pages/templates/bindings.js"
