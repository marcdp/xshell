                                        "path": "modules/controller",
                                        "href": "/pages/modules/controller.js"
                                    },
                                    {
                                        "label": "Menu Contributions",
                                        "path": "modules/menus",
                                        "href": "/pages/modules/menus.js"
                                    }
                                ]
                            },
                            {
                                "label": "Advanced Runtime",
                                "path": "advanced",
                                "href": "/pages/advanced/index.js",
                                "children": [
                                    {
                                        "label": "Injected Services",
                                        "path": "advanced/services",
                                        "href": "/pages/advanced/services.js"
