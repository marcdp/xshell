{
    // module
    "modules": {
        "x-store": {
            "label": "x-store",
            "version": "0.9.0",
            "icon": "",
            "copyright": "",
            "defaults": {
                "component": {
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": {
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "dependencies": {
                "x": "module:x:latest",
                "xshell": "module:xshell:latest"
            }
        }
    },

    "xshell": {
        "services": {
            "search": {
                "options": {
                    "providers": {
                        "stores": {
                            "label": "Stores",
                            "description": "Find Store collections",
                            "icon": "x-database",
                            "implementation": "/providers/search-stores.js",
                            "mode": "explicit",
                            "prefixes": ["store:"],
                            "options": {"sources": ["mem:"]}
                        }
                    }
                }
            },
            // The Stores Service owns provider matching. Loader caching gives each logical identity one application-lifetime instance.
            "stores": {
                "contract": "stores",
                "implementation": "/services/stores.js",
                "lifetime": "singleton",
                "options": {
                    "providers": {
                        "mem": {"implementation": "/providers/store-mem.js"}
                    }
                }
            }
        }
    }
}
