{

    // modules
    "modules": {},

    // xshell
    "xshell": {

        // core
        "version": "0.9.0",
        "assets": {
            "basePath": "app:/_assets",
            "url": "url:./"
        },
        
        // resolver
        "resolver": {
            "component": {
                "x-page": {"src": "/x-page.js", "loader": "component-js", "cache": true}
            },
            "dataset": {
                "static:{definition}": {"src": "static:{definition}", "loader": "dataset-static"},
                "url:{definition}":    {"src": "{definition}", "loader": "dataset-url"}
            },
            "http": {
                "{url}": {"src": "http:{url}","loader": "response-http", "cache": false}
            },
            "https": {
                "{url}": {"src": "https:{url}","loader": "response-http", "cache": false}
            },
            "esm": {
                "xshell": {"src": "/xshell.js", "loader": "esm-js", "cache": true}
            },
            "render-engine": {
                "{name}": {"src": "/render-engines/{name}.js","loader": "esm-js", "cache": true}
            },
            "state-engine": {
                "{name}": {"src": "/state-engines/{name}.js","loader": "esm-js", "cache": true}
            }
        },

        // services
        "services": {
            "areas": {
                "contract": "areas",
                "implementation": "/services/areas.js",
                "lifetime": "singleton",
                "options": {
                    "default": "main",
                    "definitions": {}
                }
            },
            "commands": {
                "contract": "commands",
                "implementation": "/services/commands.js",
                "lifetime": "singleton"
            },
            "queries": {
                "contract": "queries",
                "implementation": "/services/queries.js",
                "lifetime": "singleton"
            },
            "dialog": {
                "contract": "dialog",
                "implementation": "/services/dialog.js",
                "lifetime": "singleton",
                "options": {
                    "confirm": null,
                    "message": null,
                    "prompt": null,
                    "picker": null
                }
            },
            "events": {
                "contract": "events",
                "implementation": "/services/events.js",
                "lifetime": "transient"
            },
            "i18n": {
                "contract": "i18n",
                "implementation": "/services/i18n.js",
                "lifetime": "singleton"
            },
            "jsonValidator": {
                "contract": "json-validator",
                "implementation": "/services/json-validator.js",
                "lifetime": "singleton"
            },
            "modules": {
                "contract": "modules",
                "implementation": "/services/modules.js",
                "lifetime": "singleton"
            },
            "navigation": {
                "contract": "navigation",
                "implementation": "/services/navigation.js",
                "lifetime": "singleton",
                "options": {
                    "mode": "path",
                    "globalPrefix": "/global"
                }
            },
            "preferences": {
                "contract": "preferences",
                "implementation": "/services/preferences.js",
                "lifetime": "singleton",
                "options": {
                    "page": null
                }
            },
            "secrets": {
                "contract": "secrets",
                "implementation": "/services/secrets.js",
                "lifetime": "singleton",
                "options": {
                    "rememberMinutes": 60,
                    "maxRememberMinutes": 43200,
                    "pageUnlock": null,
                    "pageManager": null
                }
            },
            "search": {
                "contract": "search",
                "implementation": "/services/search.js",
                "lifetime": "singleton",
                "options": {
                    "providers": {}
                }
            },
            "menuShortcuts": {
                "contract": "menu-shortcuts",
                "implementation": "/services/menu-shortcuts.js",
                "lifetime": "singleton"
            },
            "tasks":{
                "contract": "tasks",
                "implementation": "/services/tasks.js",
                "lifetime": "singleton"
            },
            "timer": {
                "contract": "timer",
                "implementation": "/services/timer.js",
                "lifetime": "transient"
            },
            "temp": {
                "contract": "temp",
                "implementation": "/services/temp.js",
                "lifetime": "singleton",
                "options": {
                    "url": null
                }
            }
        },

        // ui
        "ui": {
            "components": {
                "lazy": "",
                "error": "",
                "markdown": ""
            },
            "layouts": {
                "default": null,
                "dialog": null,
                "dock": null,
                "main": null,
                "stack": null,
                "embed": null
            }
        }       

    }
}
