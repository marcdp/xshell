{

    // module
    "modules": {
        "xshell-diagnostics": {
            "label": "XShell Diagnostics",
            "version": "0.9.0",
            "icon": "xshell-diagnostics",
            "copyright": "",
            "defaults": {
                "component": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "menus": {
                "navigation": "/pages",
                "shortcuts": [
                    {"label":"", "icon": "xshell-diagnostics", "href": "/pages/index.js", "open": "dock", "default": true }
                ]
            },
            "dependencies": {
                "x": "module:x:latest"
            }
        }
    },

    // xshell 
    "xshell": {
        "areas": {
            "definitions": {
                "xshell-diagnostics": {
                    "prefix": "xshell-diagnostics",
                    "label": "XShell diagnostics",
                    "description": "Diagnostics for XShell",
                    "icon": "xshell-diagnostics",
                    "modules": [ "xshell-diagnostics" ]
                }
            }
        }
    }

}
