// x-demo is a separate application root. Launch it with the x-demo profile.
{
    "modules": {
        "x-demo": {
            "label": "XShell Cookbook",
            "version": "0.9.0",
            "icon": "",
            "copyright": "",
            "defaults": {
                "component": {
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": {
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "routes": {
                "/hello/{name}": "/pages/02-pages/03-parameters.js"
            },
            "dependencies": {
                "x":                    "module:x:latest",
                "x-filesystem":         "module:x-filesystem:latest",    
                "x-home":               "module:x-home:latest",
                "x-logger":             "module:x-logger:latest",
                "x-store":              "module:x-store:latest",
                "x-vault":              "module:x-vault:latest",
                "xshell":               "module:xshell:latest",
                "xshell-diagnostics":   "module:xshell-diagnostics:latest",
                "xshell-docs":          "module:xshell-docs:latest",
                "codemirror":           "module:codemirror:latest"
            }
        }
    },
    "xshell": {
        "services": {
            "areas": {
                "options": {
                    "default": "cookbook",
                    "definitions": {
                        "cookbook": {
                            "prefix": "cookbook",
                            "label": "Cookbook",
                            "description": "Focused examples of XShell features",
                            "modules": [
                                "x-demo"
                            ],
                            "menus": { "navigation": "cookbook" }
                        },
                        "launcher": {
                            "prefix": "launcher",
                            "label": "Home Launcher",
                            "description": "An Area that opens the reusable Home Page",
                            "icon": "x:x-home",
                            "modules": ["x-home"],
                            "menus": { "navigation": "home" }
                        }
                    }
                }
            },
            "menus": {
                "options": {
                    "definitions": {
                        "cookbook": { "sources": [{ "source": "/pages" }] },
                        "global": {
                            "items":[
                                {"label": "Home", "icon":"x-home", "href": "/pages/index.js?home=1", "order": -1},
                                {"label": "-", "order": -1},
                                {"label": "Demo", "order": -1, "icon":"x-demo", "href": "/pages/index.js"}
                            ]
                        }
                    }
                }
            },
            "logger": {
                "options": {
                    "provider": "indexeddb",
                    "providers": {
                        "indexeddb": {"options": {"maxEntries": 50000, "retentionDays": 30}}
                    }
                }
            }
        }
    }
}
