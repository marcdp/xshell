{
    // module
    "modules": {
        "x-filesystem": {
            "label": "x-filesystem",
            "version": "0.9.0",
            "icon": "",
            "copyright": "",
            "defaults": {
                "component": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "dependencies": {
                "x": "module:x:latest"
            }
        }
    },

    "xshell": {

        // XShell specific configuration for the x-filesystem module
        "registry": {
            "filecommands": {
                "schema": "/schemas/filecommand.schema.json",
                "contributions": [
                    {"id": "encrypt-aes", "label": "Encrypt", "icon":"x-lock", "extensions": ["txt", "json", "md"]}
                ]
            }
        },

        // resolver
        "resolver": {
            "filesystem": {
                "mem:": {"src": "/js/filesystem-mem.js", "loader": "instance-js"},
                "http:{url}": {"src": "/js/filesystem-http.js", "loader": "instance-js"},
                "https:{url}": {"src": "/js/filesystem-http.js", "loader": "instance-js"},
                "opfs:": {"src": "/js/filesystem-opfs.js", "loader": "instance-js"},
                "file:": {"src": "/js/filesystem-file.js", "loader": "instance-js"}
            },
            "filehandler": {

                /* images */
                "png": {"src": "/pages/editor-image.js", "loader": "page-js"},
                "png.aes": {"src": "/pages/editor-image.js", "loader": "page-js"},
                "jpg": {"src": "/pages/editor-image.js", "loader": "page-js"},
                "jpg.aes": {"src": "/pages/editor-image.js", "loader": "page-js"},
                "jpeg": {"src": "/pages/editor-image.js", "loader": "page-js"},
                "jpeg.aes": {"src": "/pages/editor-image.js", "loader": "page-js"},
                "gif": {"src": "/pages/editor-image.js", "loader": "page-js"},
                "svg": {"src": "/pages/editor-image.js", "loader": "page-js"},  

                /* text files */
                "txt": {"src": "/pages/editor-text.js", "loader": "page-js"},
                "txt.aes": {"src": "/pages/editor-text.js", "loader": "page-js"},
                "md": {"src": "/pages/editor-text.js", "loader": "page-js"},
                "md.aes": {"src": "/pages/editor-text.js", "loader": "page-js"},
                "env": {"src": "/pages/editor-text.js", "loader": "page-js"},
                "css": {"src": "/pages/editor-text.js", "loader": "page-js"},
                "xml": {"src": "/pages/editor-text.js", "loader": "page-js"},
                "js": {"src": "/pages/editor-text.js", "loader": "page-js"},   
                "json": {"src": "/pages/editor-text.js", "loader": "page-js"},   
                "html": {"src": "/pages/editor-text.js", "loader": "page-js"},
                "cs": {"src": "/pages/editor-text.js", "loader": "page-js"},
                "yaml": {"src": "/pages/editor-text.js", "loader": "page-js"},
                "yml": {"src": "/pages/editor-text.js", "loader": "page-js"},
                "php": {"src": "/pages/editor-text.js", "loader": "page-js"},
                "ps1": {"src": "/pages/editor-text.js", "loader": "page-js"},

                /* other */
                "pdf": {"src": "/pages/editor-iframe.js", "loader": "page-js"}

            }
        }
    }

}
