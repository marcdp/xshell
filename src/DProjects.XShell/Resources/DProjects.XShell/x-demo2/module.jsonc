                                        "href": "/pages/advanced/engines.js"
                                    },
                                    {
                                        "label": "Client Renderer",
                                        "path": "advanced/client-renderer",
                                        "href": "/pages/advanced/client-renderer.js"
                                    },
                                    {
                                        "label": "Resolver and Loader",
                                        "path": "advanced/loading",
                                        "href": "/pages/advanced/loading.js"
                                    },
                                    {
                                        "label": "Module Dataset",
                                        "path": "advanced/datasets",
                                        "href": "/pages/advanced/datasets.js"
                                    },
                                    {
                                        "label": "Static Dataset",
                                        "path": "advanced/static-dataset",
                                        "href": "/pages/advanced/static-dataset.js"
                                    }
                                ]
                            },
                            {
                                "label": "AI",
                                "path": "ai",
                                "href": "/pages/ai/index.js",
                                "children": [
                                    {
                                        "label": "Simulated Chat",
                                        "path": "ai/chat",
                                        "href": "/pages/ai/chat.js"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            "routes": {
                "/hello/{name}": "/pages/pages/parameters.js"
            }
        },
        "x": {
            "configUrl": "url:../x/module.jsonc"
        },
        "x-filesystem": {
            "configUrl": "url:../x-filesystem/module.jsonc"
        },
        "xshell-docs": {
            "configUrl": "url:../xshell-docs/module.jsonc"
        }
    },
    "xshell": {
        "areas": {
            "default": "cookbook",
            "definitions": {
                "cookbook": {
                    "prefix": "cookbook",
                    "label": "Cookbook",
                    "description": "Focused examples of XShell features",
                    "modules": [
                        "x-demo2"
                    ]
                }
            }
        }
    }
