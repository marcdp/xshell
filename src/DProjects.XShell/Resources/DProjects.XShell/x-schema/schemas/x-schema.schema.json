{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xshell.dev/schemas/x-schema.schema.json",
  "title": "X-Schema",
  "description": "Declarative specification for rendering and editing structured object values in XShell.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "meta", "types", "root"],
  "properties": {
    "version": { "type": "string", "const": "0" },
    "meta": { "$ref": "#/$defs/meta" },
    "root": { "type": "string", "minLength": 1, "description": "Name of the root object type declared in types." },
    "types": {
      "type": "object",
      "description": "Named reusable or recursive object type definitions.",
      "additionalProperties": { "$ref": "#/$defs/objectType" }
    }
  },

  "$defs": {
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/objectReference" },
        { "$ref": "#/$defs/fieldNode" },
        { "$ref": "#/$defs/objectNode" },
        { "$ref": "#/$defs/arrayNode" },
        { "$ref": "#/$defs/containerNode" }
      ]
    },

    "objectReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "description": "Name of an object type declared in the top-level types registry." },
        "bind": { "$ref": "#/$defs/bind" },
        "required": { "$ref": "#/$defs/requiredState" },
        "attrs": { "$ref": "#/$defs/attributes" },
        "props": { "$ref": "#/$defs/properties" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "create": { "$ref": "#/$defs/jsonValue" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },

    "objectType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "children"],
      "properties": {
        "kind": { "const": "object" },
        "description": { "type": "string" },
        "tag": { "type": "string", "minLength": 1 },
        "attrs": { "$ref": "#/$defs/attributes" },
        "props": { "$ref": "#/$defs/properties" },
        "children": { "$ref": "#/$defs/children" },
        "create": { "$ref": "#/$defs/jsonValue" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },

    "objectNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "children"],
      "properties": {
        "kind": { "const": "object" },
        "bind": { "$ref": "#/$defs/bind" },
        "required": { "$ref": "#/$defs/requiredState" },
        "description": { "type": "string" },
        "tag": { "type": "string", "minLength": 1 },
        "attrs": { "$ref": "#/$defs/attributes" },
        "props": { "$ref": "#/$defs/properties" },
        "children": { "$ref": "#/$defs/children" },
        "create": { "$ref": "#/$defs/jsonValue" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },

    "fieldNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "field" },
        "bind": { "$ref": "#/$defs/bind" },
        "required": { "$ref": "#/$defs/requiredState" },
        "description": { "type": "string" },
        "dataType": { "$ref": "#/$defs/dataType" },
        "tag": { "type": "string", "minLength": 1 },
        "attrs": { "$ref": "#/$defs/attributes" },
        "props": { "$ref": "#/$defs/properties" },
        "default": { "$ref": "#/$defs/jsonValue" },
        "reference": { "$ref": "#/$defs/dataReference" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },

    "arrayNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "item"],
      "properties": {
        "kind": { "const": "array" },
        "bind": { "$ref": "#/$defs/bind" },
        "required": { "$ref": "#/$defs/requiredState" },
        "description": { "type": "string" },
        "tag": { "type": "string", "minLength": 1 },
        "attrs": { "$ref": "#/$defs/attributes" },
        "props": { "$ref": "#/$defs/properties" },
        "item": { "$ref": "#/$defs/node" },
        "array": { "$ref": "#/$defs/arrayOptions" },
        "default": { "type": "array" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },

    "containerNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tag", "children"],
      "properties": {
        "kind": { "const": "container" },
        "description": { "type": "string" },
        "tag": { "type": "string", "minLength": 1 },
        "attrs": { "$ref": "#/$defs/attributes" },
        "props": { "$ref": "#/$defs/properties" },
        "children": { "$ref": "#/$defs/children" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },

    "children": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },

    "bind": {
      "type": "string",
      "minLength": 1,
      "description": "Path relative to the current data context. Scoped paths may use $current, $parent or $root."
    },

    "requiredState": {
      "type": "boolean",
      "default": false,
      "description": "Static required state for the bound value. A conditions.required rule, when present, dynamically overrides this state."
    },

    "dataType": {
      "enum": ["string", "number", "integer", "boolean", "date", "datetime", "time", "object", "array", "any"]
    },

    "arrayOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowAdd": { "type": "boolean", "default": true },
        "allowRemove": { "type": "boolean", "default": true },
        "allowMove": { "type": "boolean", "default": false },
        "minItems": { "type": "integer", "minimum": 0 },
        "maxItems": { "type": "integer", "minimum": 0 }
      }
    },

    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visible": { "$ref": "#/$defs/condition" },
        "hidden": { "$ref": "#/$defs/condition" },
        "enabled": { "$ref": "#/$defs/condition" },
        "disabled": { "$ref": "#/$defs/condition" },
        "readonly": { "$ref": "#/$defs/condition" },
        "required": { "$ref": "#/$defs/condition" }
      }
    },

    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/pathCondition" },
        { "$ref": "#/$defs/allCondition" },
        { "$ref": "#/$defs/anyCondition" },
        { "$ref": "#/$defs/notCondition" }
      ]
    },

    "pathCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "minProperties": 2,
      "description": "Condition evaluated against one path. When multiple comparison operators are present, all of them must evaluate to true.",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "equals": { "$ref": "#/$defs/jsonValue" },
        "notEquals": { "$ref": "#/$defs/jsonValue" },
        "exists": { "type": "boolean" },
        "in": { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        "notIn": { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        "greaterThan": { "type": ["number", "string"] },
        "greaterThanOrEqual": { "type": ["number", "string"] },
        "lessThan": { "type": ["number", "string"] },
        "lessThanOrEqual": { "type": ["number", "string"] }
      }
    },

    "allCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all"],
      "properties": {
        "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }
      }
    },

    "anyCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["any"],
      "properties": {
        "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } }
      }
    },

    "notCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["not"],
      "properties": {
        "not": { "$ref": "#/$defs/condition" }
      }
    },

    "dataReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "key", "label"],
      "properties": {
        "source": {
          "oneOf": [
            { "type": "string", "minLength": 1, "description": "Local scoped source such as $root.countries." },
            { "$ref": "#/$defs/externalReferenceSource" }
          ]
        },
        "key": { "type": "string", "minLength": 1, "description": "Property containing the value stored by the field." },
        "label": { "type": "string", "minLength": 1, "description": "Property containing the human-readable label presented to the user." }
      }
    },

    "externalReferenceSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "entity" },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "resource"],
          "properties": {
            "kind": { "const": "resource" },
            "resource": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },

    "attributes": {
      "type": "object",
      "description": "DOM attributes applied to the rendered component.",
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    },

    "properties": {
      "type": "object",
      "description": "DOM/Web Component properties applied directly to the rendered component.",
      "additionalProperties": true
    },

    "meta": {
      "type": "object",
      "description": "Compiler, source or diagnostic metadata ignored by normal rendering.",
      "additionalProperties": true
    },

    "jsonValue": {
      "description": "Any valid JSON value."
    }
  }
}