// x-demo is a separate application root. Launch it with the x-demo profile.
{
    "modules": {
        "x-demo": {
            "label": "XShell Cookbook",
            "version": "0.9.0",
            "icon": "",
            "copyright": "",
            "defaults": {
                "component": {
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": {
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "menus": {
                "navigation": "/pages"
            },
            "routes": {
                "/hello/{name}": "/pages/02-pages/03-parameters.js"
            },
            "dependencies": {
                "x": "module:x:*",
                "x-filesystem": "module:x-filesystem:*",    
                "x-identity": "module:x-identity:*",
                "xshell-diagnostics": "module:xshell-diagnostics:*",
                "xshell-docs": "module:xshell-docs:*"
            }
        },
        "x": {
            "configUrl": "url:../x/manifest.jsonc"
        },
        "x-filesystem": {
            "configUrl": "url:../x-filesystem/manifest.jsonc"
        },
        "x-identity": {
            "configUrl": "url:../x-identity/manifest.jsonc"
        },
        "xshell-diagnostics": {
            "configUrl": "url:../xshell-diagnostics/manifest.jsonc"
        },
        "xshell-docs": {
            "configUrl": "url:../xshell-docs/manifest.jsonc"
        }
    },
    "xshell": {
        "areas": {
            "default": "cookbook",
            "definitions": {
                "cookbook": {
                    "prefix": "cookbook",
                    "label": "Cookbook",
                    "description": "Focused examples of XShell features",
                    "modules": [
                        "x-demo",
                        "x-identity"
                    ]
                }
            }
        }
    }
}
