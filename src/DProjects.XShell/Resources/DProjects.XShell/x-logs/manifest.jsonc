{
    // Module
    "modules": {
        "x-logs": {
            "label": "x-logs",
            "version": "0.9.0",
            "tags": ["logging", "diagnostics", "observability"],
            "icon": "",
            "copyright": "",
            "defaults": {
                "component": {"renderEngine": "x", "stateEngine": "proxy"},
                "page": {"renderEngine": "x", "stateEngine": "proxy"}
            },
            "dependencies": {"x": "module:x:latest"}
        }
    },

    "xshell": {
        // Keep the public tag in this module rather than using the generic x-* resolver.
        "resolver": {
            "component": {
                "x-logview": {"src": "/components/x-logview.js", "loader": "component-js", "cache": true, "moduleId": "x-logs", "modulePath": "/"}
            }
        },

        // Logger providers, log reader service and optional Diagnostics tabs
        "services": {
            "menus": {
                "options": {
                    "definitions": {
                        "diagnostics": {
                            "items": [{
                                "id": "console",
                                "children": [{
                                    "id": "runtime",
                                    "children": [
                                        {"id": "logs", "label": "Logs", "order": 50, "path": "logs", "href": "/pages/logs.js"},
                                        {"id": "live-logs", "label": "Live Logs", "order": 60, "path": "live-logs", "href": "/pages/live-logs.js"}
                                    ]
                                }]
                            }]
                        }
                    }
                }
            },
            "logger": {
                "options": {
                    "providers": {
                        "console": {"implementation": "/providers/logger-console.js"},
                        "indexeddb": {
                            "implementation": "/providers/logger-indexeddb.js",
                            "options": {"maxEntries": 10000, "retentionDays": 7}
                        }
                    }
                }
            },
            "logReader": {
                "contract": "log-reader",
                "implementation": "/services/log-reader.js",
                "lifetime": "singleton",
                "options": {
                    "provider": null,
                    "providers": {
                        "indexeddb": {"implementation": "/providers/log-reader-indexeddb.js"}
                    }
                }
            }
        }
    }
}
