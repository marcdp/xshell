                                        "href": "/pages/components/composition.js"
                                    },
                                    {
                                        "label": "Component Contract",
                                        "path": "components/contract",
                                        "href": "/pages/components/contract.js"
                                    }
                                ]
                            },
                            {
                                "label": "Pages",
                                "path": "pages",
                                "href": "/pages/pages/index.js",
                                "children": [
                                    {
                                        "label": "Basic Page",
                                        "path": "pages/basic",
                                        "href": "/pages/pages/basic.js"
                                    },
                                    {
                                        "label": "HTML Page",
                                        "path": "pages/html-page",
                                        "href": "/pages/pages/html-page.js"
                                    },
                                    {
                                        "label": "Page Parameters",
                                        "path": "pages/parameters",
                                        "href": "/pages/pages/parameters.js"
