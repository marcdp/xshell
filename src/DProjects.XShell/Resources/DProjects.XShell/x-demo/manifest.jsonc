// x-demo is a separate application root. Launch it with the x-demo profile.
{
    "modules": {
        "x-demo": {
            "label": "XShell Cookbook",
            "version": "0.9.0",
            "icon": "",
            "copyright": "",
            "defaults": {
                "component": {
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": {
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "menus": {
                "navigation": "/pages"
            },
            "routes": {
                "/hello/{name}": "/pages/02-pages/03-parameters.js"
            },
            "dependencies": {
                "x":                    "module:x:latest",
                "x-filesystem":         "module:x-filesystem:latest",    
                "x-identity":           "module:x-identity:latest",
                "xshell":               "module:xshell:latest",
                "xshell-diagnostics":   "module:xshell-diagnostics:latest",
                "xshell-docs":          "module:xshell-docs:latest",
                "codemirror":           "module:codemirror:latest"
            }
        }
    },
    "xshell": {
        "areas": {
            "default": "cookbook",
            "definitions": {
                "cookbook": {
                    "prefix": "cookbook",
                    "label": "Cookbook",
                    "description": "Focused examples of XShell features",
                    "modules": [
                        "x-demo",
                        "x-identity"
                    ]
                }
            }
        }
    }
}
