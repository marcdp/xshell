{

    // module
    "modules": {
        "xshell-diagnostics": {
            "label": "XShell Diagnostics",
            "version": "0.9.0",
            "icon": "xshell-diagnostics",
            "copyright": "",
            "defaults": {
                "component": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "menus": {
                "navigation": "/pages",
                "shortcuts": [
                    {"id": "root", "children": [
                        {"label": "-", "order": 99},
                        {"label": "Diagnostics console", "href": "/pages/index.js", "open": "dock" }
                    ]}
                ]
            },
            "dependencies": {
                "x": "module:x:latest"
            }
        }
    },

    // xshell 
    "xshell": {
        "services": {
            "areas": {
                "options": {
                    "definitions": {
                        "xshell-diagnostics": {
                            "prefix": "xshell-diagnostics",
                            "label": "XShell diagnostics",
                            "description": "Diagnostics for XShell",
                            "icon": "xshell-diagnostics",
                            "modules": [ "xshell-diagnostics" ]
                        }
                    }
                }
            }
        }
    }

}
