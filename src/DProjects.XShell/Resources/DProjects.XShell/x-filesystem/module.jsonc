{
    // module
    "modules": {
        "x-filesystem": {
            "label": "x-filesystem",
            "version": "1.0.0",
            "icon": "",
            "copyright": "",
            "defaults": {
                "component": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            }
        }
    },

    "xshell": {
        "services": {
            "filesystemFactory": {
                "contract": "filesystem-factory",
                "implementation": "/services/filesystem-factory.js"
            }
        }
    }

}
