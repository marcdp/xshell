{
    //"$schema": "../../xshell/schemas/config.schema.json",

    // module
    "modules": {
        "x": {
            "label": "X module",
            "description": "Lorem ipsum",
            "version": "0.9.0",
            "copyright": "",
            "icon": "",
            "defaults": {
                "component": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "menus": {
                "global": {
                    "scope": "global",
                    "label": "Preferences",
                    "description": "Manage application preferences.",
                    "icon": "x-settings",
                    "items":[
                        {"label": "-", "order":100},
                        {"label": "Search", "icon":"x-search", "children": [
                            {"label": "Search Options", "href": "/pages/search.js", "open": "embed", "outlet": "self"}
                        ]},
                        {"label": "-", "order":900, "class": "flex"},                        
                        {"label": "Expand", "icon":"x-sidebar-off", "command": "expand", "class":"expand"},
                        {"label": "Collapse", "icon":"x-sidebar-on", "command": "collapse", "class":"collapse"},
                        {"label": "Tasks", "icon":"x-tasks", "class": "tasks top right", "children": [
                            {"label": "Background Tasks", "href": "/pages/tasks.js", "open": "embed", "outlet": "self"}
                        ]},
                        {"id": "root", "label": "Settings", "icon": "x-settings", "class": "top right", "children": [
                            {"label": "Preferences", "href": "/pages/workspace.js?menu-name=preferences", "open":"stack"},
                            {"label": "-", "order": 100},
                            {"label": "About", "href": "/pages/about.js"}
                        ]}
                    ]
                },
                "preferences": {
                    "scope": "global",
                    "label": "Preferences",
                    "description": "Manage application preferences.",
                    "icon": "x-settings",
                    "items": [
                        {"label": "Appearance", "href": "/pages/preferences/appearance.js"},
                        {"label": "Browser permissions", "href": "/pages/preferences/browser-permissions.js"},
                        {"label": "Internationalization", "href": "/pages/preferences/i18n.js"},
                        {"label": "Modules", "href": "/pages/preferences/modules.js"},
                        {"label": "Secrets", "href": "/pages/preferences/secrets.js"},
                        {"label": "-", "order": 100},
                        {"label": "About", "href": "/pages/about.js"}
                    ]
                }
            }
        }
    },

    // resolver
    "xshell": {
        
        // services
        "services": {
            // i18n
            "i18n": {
                "options": {
                    "lang": "en",
                    "langs": [
                        { "id": "en", "label": "English" },
                        { "id": "es", "label": "Spanish" },
                        { "id": "fr", "label": "French" },
                        { "id": "de", "label": "German" }
                    ],
                    "datetime": {
                        "options": {
                            "year": "numeric",
                            "month": "2-digit",
                            "day": "2-digit",
                            "hour": "2-digit",
                            "minute": "2-digit",
                            "second": "2-digit"
                        },
                        "formats": {
                            "time": {
                                "timeStyle": "short"
                            },
                            "date": {
                                "dateStyle": "short"
                            },
                            "datetime": {
                                "timeStyle": "short",
                                "dateStyle": "short"
                            }
                        }
                    },
                    "strings": {}
                }
            },
            "dialog": {
                "options": {
                    "confirm": "/pages/dialog-confirm.js",
                    "message": "/pages/dialog-message.js",
                    "prompt": "/pages/dialog-prompt.js",
                    "picker": "/pages/dialog-picker.js"
                }
            },

            "markdown": {
                "contract": "markdown",
                "implementation": "/services/markdown-default.js",
                "lifetime": "singleton"
            },
            "preferences": {
                "options": {
                    "page": "/pages/workspace.js?menu-name=preferences"
                }
            },
            "secrets": {
                "options": {
                    "pageUnlock": "/pages/preferences/secrets-unlock.js",
                    "pageManager": "/pages/preferences/secrets.js"
                }
            },
            "search": {
                "options": {
                    "providers": {
                        "areas": {
                            "label": "Pages",
                            "description": "Search effective Area navigation Pages",
                            "icon": "x-page",
                            "implementation": "/providers/search-areas.js",
                            "mode": "default",
                            "prefixes": ["page:"]
                        },
                        "modules": {
                            "label": "Modules",
                            "description": "Search application module metadata",
                            "icon": "x-module",
                            "implementation": "/providers/search-modules.js",
                            "mode": "default",
                            "prefixes": ["module:"]
                        },
                        "commands": {
                            "label": "Commands",
                            "description": "Search discovered Commands",
                            "icon": "x-command",
                            "implementation": "/providers/search-commands.js",
                            "mode": "default",
                            "prefixes": ["command:", "commands:", ">"]
                        },
                        "queries": {
                            "label": "Queries",
                            "description": "Search discovered Queries",
                            "icon": "x-search",
                            "implementation": "/providers/search-queries.js",
                            "mode": "default",
                            "prefixes": ["query:"]
                        },
                        "shortcuts": {
                            "label": "Shortcuts",
                            "description": "Search effective global menu destinations",
                            "icon": "x-link",
                            "implementation": "/providers/search-shortcuts.js",
                            "mode": "default"
                        }
                    }
                }
            },
            "theme": {
                "contract": "theme",
                "implementation": "/services/theme-default.js",
                "lifetime": "singleton"
            },
            "toast": {
                "contract": "toast",
                "implementation": "/services/toast-default.js",
                "lifetime": "singleton"
            }
        },

        // ui
        "ui": {
            "components": {
                "lazy": "x-lazy",
                "error": "x-error",
                "markdown": "x-markdown"
            },
            "layouts": {
                "default": "x-layout-default",
                "dialog": "x-layout-dialog",
                "dock": "x-layout-dock",
                "main": "x-layout-main",
                "stack": "x-layout-stack",
                "embed": "x-layout-embed"
            }
        }        
    }
}
