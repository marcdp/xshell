// x-demo2 is a separate application root. Launch it with the x-demo2 profile.
{
    "modules": {
        "x-demo2": {
            "label": "XShell Cookbook",
            "version": "1.0.0",
            "icon": "",
            "copyright": "",
            "defaults": {
                "component": {
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": {
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "menus": {
                "navigation": "/pages"
            },
            "routes": {
                "/hello/{name}": "/pages/02-pages/03-parameters.js"
            }
        },
        "x": {
            "configUrl": "url:../x/module.jsonc"
        },
        "x-filesystem": {
            "configUrl": "url:../x-filesystem/module.jsonc"
        },
        "xshell-docs": {
            "configUrl": "url:../xshell-docs/module.jsonc"
        }
    },
    "xshell": {
        "areas": {
            "default": "cookbook",
            "definitions": {
                "cookbook": {
                    "prefix": "cookbook",
                    "label": "Cookbook",
                    "description": "Focused examples of XShell features",
                    "modules": [
                        "x-demo2"
                    ]
                }
            }
        }
    }
}
