// x-demo2 is a separate application root. Launch it with the x-demo2 profile.
{
    "modules": {
        "x-demo2": {
            "label": "XShell Cookbook",
            "version": "1.0.0",
            "icon": "",
            "copyright": "",
            "defaults": {
                "component": {
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": {
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "menus": {
                "navigation": [
                    {
                        "label": "XShell Cookbook",
                        "path": "home",
                        "href": "/pages/index.js",
                        "default": true,
                        "children": [
                            {
                                "label": "Components",
                                "path": "components",
                                "href": "/pages/components/index.js",
                                "children": [
                                    {
                                        "label": "Buttons",
                                        "path": "components/buttons",
                                        "href": "/pages/components/buttons.js"
                                    },
                                    {
                                        "label": "Indicators",
                                        "path": "components/indicators",
                                        "href": "/pages/components/indicators.js"
                                    },
                                    {
                                        "label": "Form Inputs",
                                        "path": "components/forms",
                                        "href": "/pages/components/forms.js"
                                    },
                                    {
                                        "label": "Data Display",
                                        "path": "components/data-display",
                                        "href": "/pages/components/data-display.js"
                                    },
                                    {
                                        "label": "Lists",
                                        "path": "components/lists",
                                        "href": "/pages/components/lists.js"
                                    },
                                    {
                                        "label": "Layouts",
                                        "path": "components/layout",
                                        "href": "/pages/components/layout.js"
                                    },
                                    {
