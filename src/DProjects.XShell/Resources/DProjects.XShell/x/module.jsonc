{
    //"$schema": "../../xshell/schemas/config.schema.json",

    // module
    "modules": {
        "x": {
            "label": "X module",
            "version": "1.0.0",
            "copyright": "",
            "icon": "",
            "defaults": {
                "component": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "menus": {
                "shortcuts": [
                    {"label": "", "icon": "x-more-vert", "class": "", "children": [
                        {"label": "Settings", "href": "/pages/settings.js", "embedded":true},
                        {"label": "-"},
                        {"label": "About", "icon": "x-xshell", "href": "/pages/about.js"}
                    ] }
                ]
            }
        },
        "codemirror": {
            "configUrl": "url:../codemirror/module.jsonc"
        }
    },

    // resolver
    "xshell": {

        // i18n
        "i18n": {
            "lang": "en",
            "langs": [
                { "id": "en", "label": "English" },
                { "id": "es", "label": "Spanish" },
                { "id": "fr", "label": "French" },
                { "id": "de", "label": "German" }
            ],
            "datetime": {
                "options": {
                    "year": "numeric",
                    "month": "2-digit",
                    "day": "2-digit",
                    "hour": "2-digit",
                    "minute": "2-digit",
                    "second": "2-digit"
                },
                "formats": {
                    "time": {
                        "timeStyle": "short"
                    },
                    "date": {
                        "dateStyle": "short"
                    },
                    "datetime": {
                        "timeStyle": "short",
                        "dateStyle": "short"
                    }
                }
            },
            "strings": {}
        },

        // services
        "services": {
            "theme": {
                "contract": "theme",
                "implementation": "/services/theme.js"
            },
            "toast": {
                "contract": "toast",
                "implementation": "/services/toast-default.js"
            }
        },

        // ui
        "ui": {
            "component": {
                "lazy": "x-lazy",
                "error": "x-error",
                "markdown": "x-markdown"
            },
            "dialog": {
                "confirm": "/pages/dialog-confirm.js",
                "message": "/pages/dialog-message.js",
                "prompt": "/pages/dialog-prompt.js",
                "picker": "/pages/dialog-picker.js"
            },
            "layout": {
                "default": "x-layout-default",
                "dialog": "x-layout-dialog",
                "main": "x-layout-main",
                "stack": "x-layout-stack",
                "embed": "x-layout-embed"
            },
            "page":{
            }
        }        
    }
}
