{

    // module
    "modules": {
        "xshell-diagnostics": {
            "label": "XShell Diagnostics",
            "version": "0.9.0",
            "icon": "xshell-diagnostics",
            "copyright": "",
            "defaults": {
                "component": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "dependencies": {
                "x": "module:x:latest"
            }
        }
    },

    // xshell 
    "xshell": {
        "services": {
            "menus": {
                "options": {
                    "definitions": {
                        "diagnostics": { "sources": [{ "source": "/pages" }] },
                        "global": {
                            "items": [
                                {"id": "root", "children": [
                                    {"label": "-", "order": 99},
                                    {"label": "Diagnostics console", "order": 99, "href": "/pages/index.js", "open": "dock" }
                                ]}
                            ]
                        }
                    }
                }
            },
            "areas": {
                "options": {
                    "definitions": {
                        "xshell-diagnostics": {
                            "prefix": "xshell-diagnostics",
                            "label": "XShell diagnostics",
                            "description": "Diagnostics for XShell",
                            "icon": "xshell-diagnostics",
                            "modules": [ "xshell-diagnostics" ],
                            "menus": { "navigation": "diagnostics" }
                        }
                    }
                }
            }
        }
    }

}
