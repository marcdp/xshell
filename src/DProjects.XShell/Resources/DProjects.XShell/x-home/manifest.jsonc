{
    // Areas can select home for their navigation slot.
    "modules": {
        "x-home": {
            "label": "Home",
            "version": "0.9.0",
            "copyright": "",
            "icon": "x:x-home",
            "defaults": {
                "component": { "renderEngine": "x", "stateEngine": "proxy" },
                "page": { "renderEngine": "x", "stateEngine": "proxy" }
            },
            "dependencies": {
                "x": "module:x:latest"
            }
        }
    },
    "xshell": {
        "services": {
            "menus": {
                "options": {
                    "definitions": {
                        "global": {
                            "items":[
                                {"label": "Home", "icon":"x-home", "href": "/pages/index.js"}
                            ]
                        },
                        "home": {
                            "items": [
                                { "label": "Home", "icon": "x:x-home", "path": "home", "href": "/pages/index.js" }
                            ]
                        }
                    }
                }
            }
        }
    }
}
