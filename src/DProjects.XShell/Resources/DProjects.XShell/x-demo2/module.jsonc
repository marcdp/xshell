                            {
                                "label": "Navigation",
                                "path": "navigation",
                                "href": "/pages/navigation/index.js",
                                "children": [
                                    {
                                        "label": "Navigation Actions",
                                        "path": "navigation/basic",
                                        "href": "/pages/navigation/basic.js"
