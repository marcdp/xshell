{
    // module
    "modules": {
        "x-filesystem": {
            "label": "x-filesystem",
            "version": "0.9.0",
            "tags": ["filesystem", "files", "storage"],
            "icon": "",
            "copyright": "",
            "defaults": {
                "component": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "dependencies": {
                "x": "module:x:latest"
            },
            "menus": {
                "preferences": {
                    "items": [
                        {"label": "Filesystems", "href": "/pages/preferences/filesystems.js"},
                    ]
                }
            }
        }
    },

    "xshell": {

        // XShell specific configuration for the x-filesystem module
        "services": {
            "filesystems": {
                "contract": "filesystems",
                "implementation": "/services/filesystems.js",
                "lifetime": "singleton",
                "options": {
                    "commands": [
                        {"id": "filesystem.entry.encrypt.aes", "label": "Encrypt", "icon":"x-lock", "type": "file", "extensions": ["txt", "json", "md"], "actions": []},
                        {"id": "filesystem.entry.zip", "label": "Download as ZIP", "type":"entry", "icon":"x-zip", "actions": []}
                    ],
                    "editors": {
                        "text": {"page": "/pages/editor-text.js", "label": "Open", "icon": "x-preview", "extensions": ["txt", "txt.aes", "json", "jsonc", "md", "md.aes", "env", "css", "xml", "js", "html", "cs", "yaml", "yml", "php", "ps1", "ovpn"]},
                        "image": {"page": "/pages/editor-image.js", "label": "Open", "icon": "x-preview", "extensions": ["png", "png.aes", "jpg", "jpg.aes", "jpeg", "jpeg.aes", "gif", "gif.aes", "svg"]},
                        "iframe": {"page": "/pages/editor-iframe.js", "label": "Open", "icon": "x-preview", "extensions": ["pdf"]}
                    },
                    "providers": {
                        "mem": {"implementation": "/providers/filesystem-mem.js"},
                        "http": {"implementation": "/providers/filesystem-http.js", "options": {"scheme": "http"}},
                        "https": {"implementation": "/providers/filesystem-http.js", "options": {"scheme": "https"}},
                        "opfs": {"implementation": "/providers/filesystem-opfs.js"},
                        "file": {"implementation": "/providers/filesystem-file.js"}
                    }
                }
            }
        }
    }

}
