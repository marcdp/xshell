{

    // module
    "modules": {
        "xshell-docs": {
            "label": "XShell docs",
            "version": "0.9.0",
            "icon": "xshell-docs",
            "copyright": "",
            "defaults": {
                "component": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "menus": {
                "navigation": "/pages"
            },
            "dependencies": {
                "x": "module:x:*"
            }
        }
    },

    // xshell 
    "xshell": {
        "areas": {
            "definitions": {
                "xshell-docs": {
                    "prefix": "xshell-docs",
                    "label": "Documentation",
                    "description": "Documentation for XShell",
                    "icon": "xshell-docs",
                    "modules": [ "xshell-docs" ]
                }
            }
        }
    }

}
