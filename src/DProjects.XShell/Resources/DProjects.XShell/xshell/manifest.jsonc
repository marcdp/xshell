{

    // modules
    "modules": {},

    // xshell
    "xshell": {

        // core
        "version": "0.9.0",
        "assets": {
            "basePath": "app:/_assets",
            "url": "url:./"
        },
        // areas
        "areas": {
            "default": "main",
            "global": ["shortcuts"],
            "definitions": {
            }
        },

        // resolver
        "resolver": {
            "component": {
                "x-page": {"src": "/x-page.js", "loader": "esm-js", "cache": true}
            },
            "dataset": {
                "static:{definition}": {"src": "static:{definition}", "loader": "dataset-static"},
                "url:{definition}":    {"src": "{definition}", "loader": "dataset-url"}
            },
            "http": {
                "{url}": {"src": "http:{url}","loader": "response-http", "cache": false}
            },
            "https": {
                "{url}": {"src": "https:{url}","loader": "response-http", "cache": false}
            },
            "esm": {
                "xshell": {"src": "/xshell.js", "loader": "esm-js", "cache": true}
            },
            "render-engine": {
                "{name}": {"src": "/render-engines/{name}.js","loader": "esm-js", "cache": true}
            },
            "state-engine": {
                "{name}": {"src": "/state-engines/{name}.js","loader": "esm-js", "cache": true}
            }
        },

        // services
        "services": {
            "commands": {
                "contract": "commands",
                "implementation": "/services/commands.js"
            },
            "dialog": {
                "contract": "dialog",
                "implementation": "/services/dialog.js",
                "options": {
                    "confirm": null,
                    "message": null,
                    "prompt": null,
                    "picker": null
                }
            },
            "i18n": {
                "contract": "i18n",
                "implementation": "/services/i18n.js"
            },
            "jsonValidator": {
                "contract": "json-validator",
                "implementation": "/services/json-validator.js"
            },
            "navigation": {
                "contract": "navigation",
                "implementation": "/services/navigation.js",
                "options": {
                    "mode": "path"
                }
            },
            "preferences": {
                "contract": "preferences",
                "implementation": "/services/preferences.js",
                "options": {
                    "page": null
                }
            },
            "registry": {
                "contract": "registry",
                "implementation": "/services/registry.js",
                "options": {}
            },
            "runtime": {
                "contract": "runtime",
                "implementation": "/services/runtime.js"
            },
            "secrets": {
                "contract": "secrets",
                "implementation": "/services/secrets.js",
                "options": {
                    "rememberMinutes": 60,
                    "maxRememberMinutes": 43200,
                    "pageUnlock": null,
                    "pageManager": null
                }
            },
            "tasks":{
                "contract": "tasks",
                "implementation": "/services/tasks.js"
            },
            "temp": {
                "contract": "temp",
                "implementation": "/services/temp.js",
                "options": {
                    "url": null
                }
            }
        },

        // service worker defaults
        "serviceWorker": {
        },

        // ui
        "ui": {
            "component": {
                "lazy": "",
                "error": "",
                "markdown": ""
            },
            "layout": {
                "default": null,
                "dialog": null,
                "dock": null,
                "main": null,
                "stack": null,
                "embed": null
            },
            "page": {
            }
        }       

    }
}
