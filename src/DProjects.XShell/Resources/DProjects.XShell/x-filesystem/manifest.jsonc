{
    // module
    "modules": {
        "x-filesystem": {
            "label": "x-filesystem",
            "version": "0.9.0",
            "icon": "",
            "copyright": "",
            "defaults": {
                "component": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "dependencies": {
                "x": "module:x:latest"
            }
        }
    },

    "xshell": {

        // XShell specific configuration for the x-filesystem module
        "registry": {
            "filecommands": {
                "schema": "/schemas/filecommand.schema.json",
                "contributions": [
                    {"id": "page:x-filesystem:/pages/editor-text.js", "label": "Open", "icon":"x-preview", "type": "file", "extensions": ["txt", "txt.aes", "json", "md", "md.aes", "env", "css", "xml", "js", "html", "cs", "yaml", "yml", "php", "ps1"], "actions": ["open"]},
                    {"id": "page:x-filesystem:/pages/editor-image.js", "label": "Open", "icon":"x-preview", "type": "file", "extensions": ["png", "png.aes", "jpg", "jpg.aes", "jpeg", "jpeg.aes", "gif", "gif.aes", "svg", "svg"], "actions": ["open"]},
                    {"id": "page:x-filesystem:/pages/editor-iframe.js", "label": "Open", "icon":"x-preview", "type": "file", "extensions": ["pdf"], "actions": ["open"]},
                    {"id": "command:encrypt-aes", "label": "Encrypt", "icon":"x-lock", "type": "file", "extensions": ["txt", "json", "md"], "actions": []},
                    {"id": "command:directory-zip", "label": "Create ZIP", "icon":"x-zip", "type": "directory", "actions": []}
                ]
            }
        },

        // resolver
        "resolver": {
            "filesystem": {
                "mem:": {"src": "/js/filesystem-mem.js", "loader": "instance-js"},
                "http:{url}": {"src": "/js/filesystem-http.js", "loader": "instance-js"},
                "https:{url}": {"src": "/js/filesystem-http.js", "loader": "instance-js"},
                "opfs:": {"src": "/js/filesystem-opfs.js", "loader": "instance-js"},
                "file:": {"src": "/js/filesystem-file.js", "loader": "instance-js"}
            }
            
        }
    }

}
