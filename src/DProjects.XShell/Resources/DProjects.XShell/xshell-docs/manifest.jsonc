{

    // module
    "modules": {
        "xshell-docs": {
            "label": "XShell docs",
            "version": "0.9.0",
            "icon": "xshell-docs",
            "copyright": "",
            "defaults": {
                "component": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": { 
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "dependencies": {
                "x": "module:x:latest"
            }
        }
    },

    // xshell 
    "xshell": {
        "services": {
            "menus": {
                "options": {
                    "definitions": {
                        "global": {
                            "items":[
                                {"label": "Docs", "icon":"xshell-docs", "href": "/pages/index.md"}
                            ]
                        },
                        "documentation": { "sources": [{ "source": "/pages" }] }
                    }
                }
            },
            "areas": {
                "options": {
                    "definitions": {
                        "xshell-docs": {
                            "prefix": "xshell-docs",
                            "label": "Documentation",
                            "description": "Documentation for XShell",
                            "icon": "xshell-docs",
                            "menus": { "navigation": "documentation" }
                        }
                    }
                }
            }
        }
    }

}
