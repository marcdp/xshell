{

    // modules
    "modules": {},

    // xshell
    "xshell": {

        // core
        "version": "0.9.0",
        "assets": {
            "basePath": "app:/_assets",
            "url": "url:./"
        },

        // areas
        "areas": {
            "default": "main",
            "global": ["shortcuts"],
            "definitions": {
            }
        },

        // navigation
        "navigation": {
            "mode": "path"
        },

        // registry
        "registry": {
        },

        // resolver
        "resolver": {
            "component": {
                "x-page": {"src": "/x-page.js", "loader": "esm-js", "cache": true}
            },
            "dataset": {
                "static:{definition}": {"src": "static:{definition}", "loader": "dataset-static"},
                "url:{definition}":    {"src": "{definition}", "loader": "dataset-url"}
            },
            "http": {
                "{url}": {"src": "http:{url}","loader": "response-http", "cache": false}
            },
            "https": {
                "{url}": {"src": "https:{url}","loader": "response-http", "cache": false}
            },
            "esm": {
                "xshell": {"src": "/xshell.js", "loader": "esm-js", "cache": true}
            },
            "render-engine": {
                "{name}": {"src": "/render-engines/{name}.js","loader": "esm-js", "cache": true}
            },
            "state-engine": {
                "{name}": {"src": "/state-engines/{name}.js","loader": "esm-js", "cache": true}
            }
        },

        // services
        "services": {
            "commands": {
                "contract": "commands",
                "implementation": "/services/commands.js"
            },
            "jsonValidator": {
                "contract": "json-validator",
                "implementation": "/services/json-validator.js"
            },
            "tasks":{
                "contract": "tasks",
                "implementation": "/services/tasks.js"
            },
            "temp": {
                "contract": "temp",
                "implementation": "/services/temp.js"
            }
        },

        // service worker defaults
        "serviceWorker": {
        },

        // temp
        "temp": {
            "url": "app:/temp"   
        },

        // ui
        "ui": {
            "component": {
                "lazy": "",
                "error": "",
                "markdown": ""
            },
            "dialog": {
                "confirm": null,
                "message": null,
                "prompt": null,
                "picker": null
            },
            "layout": {
                "default": null,
                "dialog": null,
                "dock": null,
                "main": null,
                "stack": null,
                "embed": null
            },
            "page": {
            }
        }       

    }
}
