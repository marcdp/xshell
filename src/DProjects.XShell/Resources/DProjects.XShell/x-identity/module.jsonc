{
    "modules": {
        "x-identity": {
            "label": "X Identity",
            "version": "0.9.0",
            "icon": "x-key",
            "copyright": "",
            "params": {
                // The host application must override these with app: or absolute HTTP(S) URLs.
                "signinUrl": null,
                "sessionUrl": null,
                "signoutUrl": null
            },
            "requires": [
                "principal",
                "signin",
                "session"
            ],
            "defaults": {
                "component": {
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                },
                "page": {
                    "renderEngine": "x",
                    "stateEngine": "proxy"
                }
            },
            "menus": {
                "shortcuts": [
                    {
                        "label": "",
                        "tooltip": "Account",
                        "icon": "x-key",
                        "children": [
                            {
                                "label": "Account",
                                "href": "/pages/shortcuts.js",
                                "embedded": true
                            }
                        ]
                    }
                ]
            },
            "routes": {
                "/login": "/pages/login.js",
                "/account": "/pages/account.js"
            }
        }
    },
    "xshell": {
        "services": {
            "principal": {
                "contract": "principal",
                "implementation": "/services/principal.js"
            },
            "signin": {
                "contract": "signin",
                "implementation": "/services/signin.js"
            },
            "session": {
                "contract": "session",
                "implementation": "/services/session.js"
            }
        }
    }
}
